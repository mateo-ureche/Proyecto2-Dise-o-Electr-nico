[Unit]
Description=Flask App - Proyecto 2
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/proyecto2
ExecStart=/home/ubuntu/proyecto2/venv/bin/gunicorn -w 2 -b 127.0.0.1:8000 app:app
Restart=always

[Install]
WantedBy=multi-user.target